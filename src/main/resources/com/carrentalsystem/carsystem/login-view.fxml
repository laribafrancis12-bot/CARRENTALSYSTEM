<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="400.0" prefWidth="640.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carrentalsystem.carsystem.LoginController">

    <VBox alignment="CENTER" prefWidth="240.0" spacing="8.0" styleClass="brand-panel">
        <Label styleClass="brand-title" text="CARECARE" textAlignment="CENTER" wrapText="true" />
    </VBox>

    <VBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="30.0" left="36.0" right="36.0" top="30.0" />
        </padding>

        <Label styleClass="title-label" text="Welcome back" />
        <Label styleClass="subtitle-label" text="Log in to continue" />

        <Label text="Username" />
        <TextField fx:id="usernameField" promptText="Enter username" />

        <Label text="Password" />
        <PasswordField fx:id="passwordField" onAction="#onLoginClick" promptText="Enter password" />

        <Button maxWidth="Infinity" onAction="#onLoginClick" styleClass="login-button" text="Log in">
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </Button>

        <Label fx:id="messageLabel" styleClass="error-label" />
    </VBox>
</HBox>
