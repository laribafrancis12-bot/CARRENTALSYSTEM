<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.carrentalsystem.carsystem.ReportController"
            prefHeight="740.0" prefWidth="1140.0"
            stylesheets="@style.css" styleClass="app-root">

    <left>
        <VBox spacing="6.0" styleClass="rail">
            <padding><Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/></padding>
            <Label text="&#128663;" styleClass="rail-logo"/>
            <Button text="Dashboard" styleClass="rail-btn-active" maxWidth="Infinity" onAction="#onDashboardClick"/>
            <Button fx:id="vehiclesBtn" text="Vehicles" styleClass="rail-btn" maxWidth="Infinity" onAction="#onVehiclesClick"/>
            <Button text="Rentals" styleClass="rail-btn" maxWidth="Infinity" onAction="#onRentalsClick"/>
            <Button text="History" styleClass="rail-btn" maxWidth="Infinity" onAction="#onHistoryClick"/>
            <Button fx:id="accountsBtn" text="Accounts" styleClass="rail-btn" maxWidth="Infinity" onAction="#onAccountsClick"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Button text="Log out" styleClass="rail-btn" maxWidth="Infinity" onAction="#onLogoutClick"/>
        </VBox>
    </left>

    <center>
        <!-- The report is a fixed-width sheet. On a small window the page scrolls; on a big one it stays centered. -->
        <ScrollPane fitToWidth="true" styleClass="plain-scroll">
            <VBox alignment="TOP_CENTER" spacing="14.0" styleClass="page-content">

                <HBox maxWidth="780.0" minWidth="780.0" alignment="CENTER_LEFT" spacing="10.0">
                    <Button text="&#8592; Back to dashboard" styleClass="modal-close" onAction="#onBackClick"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Save as PDF" styleClass="ghost-button" onAction="#onSavePdfClick"/>
                    <Button text="Print report" styleClass="cta-button" onAction="#onPrintClick"/>
                </HBox>

                <!-- ============ THE REPORT SHEET (this is what gets printed / saved) ============ -->
                <VBox fx:id="reportPaper" styleClass="rc-paper" minWidth="780.0" prefWidth="780.0" maxWidth="780.0"/>

                <Label fx:id="statusMessageLabel" styleClass="page-subtitle" wrapText="true" maxWidth="780.0"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
