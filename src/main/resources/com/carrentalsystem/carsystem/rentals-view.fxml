<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.carrentalsystem.carsystem.RentalsController"
           prefHeight="740.0" prefWidth="1140.0"
           stylesheets="@style.css" styleClass="app-root">

    <!-- Main page -->
    <BorderPane fx:id="pageRoot">
        <left>
            <VBox prefWidth="150.0" spacing="6.0" styleClass="rail">
                <padding><Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/></padding>
                <Label text="&#128663;" styleClass="rail-logo"/>
                <Button text="Dashboard" styleClass="rail-btn" maxWidth="Infinity" onAction="#onDashboardClick"/>
                <Button fx:id="vehiclesBtn" text="Vehicles" styleClass="rail-btn" maxWidth="Infinity" onAction="#onVehiclesClick"/>
                <Button text="Rentals" styleClass="rail-btn-active" maxWidth="Infinity" onAction="#onRentalsClick"/>
                <Button fx:id="accountsBtn" text="Accounts" styleClass="rail-btn" maxWidth="Infinity" onAction="#onAccountsClick"/>
                <VBox VBox.vgrow="ALWAYS"/>
                <Button text="Log out" styleClass="rail-btn" maxWidth="Infinity" onAction="#onLogoutClick"/>
            </VBox>
        </left>

        <center>
            <VBox spacing="14.0">
                <padding><Insets top="24.0" bottom="24.0" left="28.0" right="28.0"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Rentals" styleClass="page-title"/>
                        <Label fx:id="countLabel" text="0 cars currently out" styleClass="page-subtitle"/>
                    </VBox>
                    <Button text="+ New rental" styleClass="cta-button" onAction="#onNewRentalClick"/>
                </HBox>

                <TextField fx:id="searchField" promptText="Search customer or plate no." maxWidth="320.0"
                           prefHeight="38.0" styleClass="field-input"/>

                <HBox spacing="12.0" VBox.vgrow="ALWAYS">

                    <VBox styleClass="board-col" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Active" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="activeCountLabel" text="0" styleClass="badge-blue"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="activeColumn" spacing="8.0"/>
                        </ScrollPane>
                    </VBox>

                    <VBox styleClass="board-col" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Due or overdue" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="dueCountLabel" text="0" styleClass="badge-red"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="dueColumn" spacing="8.0"/>
                        </ScrollPane>
                    </VBox>

                    <VBox styleClass="board-col" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Returned" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="returnedCountLabel" text="0" styleClass="badge-green"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="returnedColumn" spacing="8.0"/>
                        </ScrollPane>
                    </VBox>

                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- New rental overlay -->
    <StackPane fx:id="newRentalOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-card" spacing="10.0" maxWidth="560.0" maxHeight="640.0">
            <padding><Insets top="26.0" bottom="26.0" left="30.0" right="30.0"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="New rental" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                <Button text="X" styleClass="modal-close" onAction="#onCancelNewRental"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0">
                    <Label text="Customer" styleClass="section-label"/>
                    <HBox spacing="14.0">
                        <VBox HBox.hgrow="ALWAYS" minWidth="180.0" spacing="4.0">
                            <Label text="Full name" styleClass="field-label"/>
                            <TextField fx:id="customerNameField" promptText="Maria Santos" prefHeight="38.0" styleClass="field-input"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" minWidth="160.0" spacing="4.0">
                            <Label text="Contact number" styleClass="field-label"/>
                            <TextField fx:id="contactField" promptText="09xx xxx xxxx" prefHeight="38.0" styleClass="field-input"/>
                        </VBox>
                    </HBox>
                    <Label text="Driver's license no." styleClass="field-label"/>
                    <TextField fx:id="licenseField" promptText="N01-23-456789" prefHeight="38.0" styleClass="field-input"/>

                    <Label text="Vehicle and dates" styleClass="section-label">
                        <VBox.margin><Insets top="10.0"/></VBox.margin>
                    </Label>
                    <Label text="Available vehicle" styleClass="field-label"/>
                    <ComboBox fx:id="vehicleCombo" maxWidth="Infinity" prefHeight="38.0" styleClass="field-input"/>
                    <HBox spacing="14.0">
                        <VBox HBox.hgrow="ALWAYS" minWidth="160.0" spacing="4.0">
                            <Label text="Rent date" styleClass="field-label"/>
                            <DatePicker fx:id="rentDatePicker" maxWidth="Infinity" prefHeight="38.0" styleClass="field-input"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" minWidth="160.0" spacing="4.0">
                            <Label text="Return date" styleClass="field-label"/>
                            <DatePicker fx:id="returnDatePicker" maxWidth="Infinity" prefHeight="38.0" styleClass="field-input"/>
                        </VBox>
                    </HBox>

                    <Label text="Payment method" styleClass="field-label">
                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                    </Label>
                    <ComboBox fx:id="paymentCombo" maxWidth="Infinity" prefHeight="38.0" styleClass="field-input"/>

                    <HBox styleClass="total-box" alignment="CENTER_LEFT">
                        <padding><Insets top="12.0" bottom="12.0" left="14.0" right="14.0"/></padding>
                        <Label fx:id="totalBreakdownLabel" text="Select a vehicle and dates" styleClass="total-breakdown" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalAmountLabel" text="&#8369;0.00" styleClass="total-amount"/>
                    </HBox>

                    <Label fx:id="formMessageLabel" styleClass="error-label" wrapText="true"/>
                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Cancel" styleClass="ghost-button" onAction="#onCancelNewRental"/>
                <Button text="Confirm and print receipt" styleClass="cta-button" onAction="#onConfirmRentalClick"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
