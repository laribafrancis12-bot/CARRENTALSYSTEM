<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.carrentalsystem.carsystem.DashboardController"
            prefHeight="720.0" prefWidth="1100.0"
            stylesheets="@style.css" styleClass="app-root">

    <left>
        <VBox spacing="6.0" styleClass="rail">
            <padding><Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/></padding>
            <VBox spacing="2.0" styleClass="nav-brand"><Label text="RENTASTIC" styleClass="nav-brand-title"/><Label text="WORKSPACE / ADMIN" styleClass="nav-brand-subtitle"/></VBox>
            <Label text="WORKSPACE" styleClass="nav-section-label"/>
                <Button text="Dashboard" styleClass="rail-btn-active" maxWidth="Infinity" onAction="#onDashboardClick"/>
            <Button fx:id="vehiclesBtn" text="Vehicles" styleClass="rail-btn" maxWidth="Infinity" onAction="#onVehiclesClick"/>
            <Button text="Rentals" styleClass="rail-btn" maxWidth="Infinity" onAction="#onRentalsClick"/>
            <Button text="History" styleClass="rail-btn" maxWidth="Infinity" onAction="#onHistoryClick"/>
            <Button fx:id="accountsBtn" text="Accounts" styleClass="rail-btn" maxWidth="Infinity" onAction="#onAccountsClick"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Label text="ACCOUNT" styleClass="nav-section-label"/>
                <Button text="Log out" styleClass="rail-btn" maxWidth="Infinity" onAction="#onLogoutClick"/>
        </VBox>
    </left>

    <center>
        <!-- Scrolls when the charts don't fit the window -->
        <ScrollPane fitToWidth="true" styleClass="plain-scroll">
            <VBox spacing="14.0" styleClass="page-content">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Dashboard" styleClass="page-title"/>
                        <Label fx:id="dateLabel" text="Logged in as Admin" styleClass="page-subtitle"/>
                    </VBox>
                    <Label fx:id="chartRefreshLabel" text="Loaded from MySQL" styleClass="page-subtitle"/>
                    <Button text="Refresh data" styleClass="ghost-button" onAction="#onRefreshDashboardClick"/>
                    <Button text="Export report" styleClass="ghost-button" onAction="#onExportReportClick"/>
                    <Button text="+ New rental" styleClass="cta-button" onAction="#onNewRentalClick"/>
                </HBox>

                <!-- Stat cards -->
                <HBox spacing="10.0">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Total vehicles" styleClass="stat-label"/>
                        <Label fx:id="totalVehiclesLabel" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Available" styleClass="stat-label"/>
                        <Label fx:id="availableLabel" text="0" styleClass="stat-value-green"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Rented out" styleClass="stat-label"/>
                        <Label fx:id="rentedLabel" text="0" styleClass="stat-value-amber"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Overdue" styleClass="stat-label"/>
                        <Label fx:id="overdueLabel" text="0" styleClass="stat-value-red"/>
                    </VBox>
                </HBox>

                <!-- Revenue (admin: company total · staff: their own sales) + Due today -->
                <HBox spacing="12.0">

                    <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label fx:id="revenueTitleLabel" text="Revenue" styleClass="section-label"/>
                        <Label fx:id="revenueMonthLabel" text="₱10" styleClass="revenue-total"/>
                        <Label fx:id="revenuePeriodLabel" text="This month" styleClass="page-subtitle"/>
                        <FlowPane hgap="8.0" vgap="8.0">
                            <Label fx:id="revenueTodayLabel" text="Today ₱10" styleClass="revenue-chip"/>
                            <Label fx:id="revenueWeekLabel" text="This week ₱10" styleClass="revenue-chip"/>
                            <Label fx:id="revenueYearLabel" text="This year ₱10" styleClass="revenue-chip"/>
                            <Label fx:id="revenueAllTimeLabel" text="All time ₱10" styleClass="revenue-chip"/>
                        </FlowPane>
                        <Label fx:id="rentalsCountLabel" text="" styleClass="page-subtitle">
                            <VBox.margin><Insets top="6.0"/></VBox.margin>
                        </Label>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Due today and overdue" styleClass="section-label"/>
                        <VBox fx:id="dueListContainer" spacing="6.0" VBox.vgrow="ALWAYS"/>
                    </VBox>

                </HBox>

                <!-- Fleet status + staff performance (admin only: it compares the staff members) -->
                <HBox spacing="12.0">
                    <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label text="Fleet status" styleClass="section-label"/>
                        <PieChart fx:id="fleetChart" animated="false" labelsVisible="false" legendSide="BOTTOM"
                                  minHeight="270.0" prefHeight="270.0"/>
                    </VBox>

                    <VBox fx:id="staffChartCard" styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label fx:id="staffChartTitleLabel" text="Staff performance - this month" styleClass="section-label"/>
                        <BarChart fx:id="staffChart" animated="false" legendVisible="false"
                                  minHeight="270.0" prefHeight="270.0">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- Revenue by month (this year) and revenue by year -->
                <HBox spacing="12.0">
                    <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label fx:id="monthChartTitleLabel" text="Revenue by month" styleClass="section-label"
                                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Label text="Year" styleClass="page-subtitle"/>
                            <ComboBox fx:id="yearCombo" prefWidth="120.0" prefHeight="36.0" styleClass="field-input"/>
                        </HBox>
                        <Label fx:id="monthYearTotalLabel" text="" styleClass="page-subtitle"/>
                        <BarChart fx:id="monthRevenueChart" animated="false" legendVisible="false"
                                  minHeight="270.0" prefHeight="270.0">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS" minWidth="0.0" prefWidth="0.0">
                        <Label fx:id="yearChartTitleLabel" text="Revenue by year" styleClass="section-label"/>
                        <BarChart fx:id="yearRevenueChart" animated="false" legendVisible="false"
                                  minHeight="270.0" prefHeight="270.0">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- Every car ranked by how many times it was rented -->
                <VBox styleClass="stat-card" spacing="6.0">
                    <Label fx:id="carRankTitleLabel" text="Most rented cars (by plate number)" styleClass="section-label"/>
                    <BarChart fx:id="carRankChart" animated="false" legendVisible="false"
                              minHeight="300.0" prefHeight="300.0">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </BarChart>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
