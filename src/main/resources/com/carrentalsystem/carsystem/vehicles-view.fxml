<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.carrentalsystem.carsystem.VehiclesController"
           prefHeight="720.0" prefWidth="1100.0"
           stylesheets="@style.css" styleClass="app-root">

    <!-- Main page -->
    <BorderPane fx:id="pageRoot">
        <left>
            <VBox spacing="6.0" styleClass="rail">
                <padding><Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/></padding>
                <Label text="&#128663;" styleClass="rail-logo"/>
                <Button text="Dashboard" styleClass="rail-btn" maxWidth="Infinity" onAction="#onDashboardClick"/>
                <Button fx:id="vehiclesBtn" text="Vehicles" styleClass="rail-btn-active" maxWidth="Infinity" onAction="#onVehiclesClick"/>
                <Button text="Rentals" styleClass="rail-btn" maxWidth="Infinity" onAction="#onRentalsClick"/>
                <Button text="History" styleClass="rail-btn" maxWidth="Infinity" onAction="#onHistoryClick"/>
                <Button fx:id="accountsBtn" text="Accounts" styleClass="rail-btn" maxWidth="Infinity" onAction="#onAccountsClick"/>
                <VBox VBox.vgrow="ALWAYS"/>
                <Button text="Log out" styleClass="rail-btn" maxWidth="Infinity" onAction="#onLogoutClick"/>
            </VBox>
        </left>

        <center>
            <VBox spacing="14.0" styleClass="page-content" BorderPane.alignment="TOP_CENTER">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Vehicles" styleClass="page-title"/>
                        <Label fx:id="countLabel" text="0 in your fleet" styleClass="page-subtitle"/>
                    </VBox>
                    <TextField fx:id="searchField" promptText="Search plate no. or model" maxWidth="280.0"
                               prefHeight="40.0" styleClass="field-input"/>
                    <Button text="+ Add vehicle" styleClass="cta-button" onAction="#onAddVehicleClick"/>
                </HBox>

                <HBox spacing="8.0">
                    <Button fx:id="filterAllBtn" text="All" styleClass="pill-active" onAction="#onFilterAll"/>
                    <Button fx:id="filterAvailableBtn" text="Available" styleClass="pill" onAction="#onFilterAvailable"/>
                    <Button fx:id="filterRentedBtn" text="Rented" styleClass="pill" onAction="#onFilterRented"/>
                    <Button fx:id="filterOverdueBtn" text="Overdue" styleClass="pill" onAction="#onFilterOverdue"/>
                    <Button fx:id="filterMaintenanceBtn" text="Maintenance" styleClass="pill" onAction="#onFilterMaintenance"/>
                    <Button fx:id="filterArchivedBtn" text="Archived" styleClass="pill" onAction="#onFilterArchived"/>
                </HBox>

                <!-- CONSTRAINED_RESIZE_POLICY makes the columns stretch/shrink with the window -->
                <TableView fx:id="vehicleTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="plateCol" text="Plate no." prefWidth="110.0"/>
                        <TableColumn fx:id="modelCol" text="Model" prefWidth="190.0"/>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="100.0"/>
                        <TableColumn fx:id="colorCol" text="Color" prefWidth="120.0"/>
                        <TableColumn fx:id="seatsCol" text="Seats" prefWidth="70.0"/>
                        <TableColumn fx:id="rateCol" text="Rate/day" prefWidth="100.0"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="120.0"/>
                        <TableColumn fx:id="actionsCol" text="Actions" prefWidth="360.0"/>
                    </columns>
                </TableView>

                <!-- Page arrows: the table shows 10 vehicles at a time -->
                <HBox alignment="CENTER" spacing="12.0">
                    <Label fx:id="pageInfoLabel" text="" styleClass="page-subtitle" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="pagePrevBtn" text="&#8592;" styleClass="pager-btn"/>
                    <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="pager-label"/>
                    <Button fx:id="pageNextBtn" text="&#8594;" styleClass="pager-btn"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- Add vehicle overlay -->
    <StackPane fx:id="addVehicleOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-card" spacing="14.0" maxWidth="540.0" maxHeight="-Infinity">
            <padding><Insets top="26.0" bottom="26.0" left="30.0" right="30.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox styleClass="modal-icon" alignment="CENTER" minWidth="44.0" minHeight="44.0"
                      maxWidth="44.0" maxHeight="44.0">
                    <Label text="&#128663;" styleClass="modal-icon-label"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Add vehicle" styleClass="modal-title"/>
                    <Label text="It will appear as available" styleClass="page-subtitle"/>
                </VBox>
                <Button text="X" styleClass="modal-close" onAction="#onCancelAddVehicle"/>
            </HBox>

            <HBox spacing="14.0">
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Plate number" styleClass="field-label"/>
                    <TextField fx:id="plateField" promptText="ABC 1234" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="plateErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Model" styleClass="field-label"/>
                    <TextField fx:id="modelField" promptText="Toyota Vios" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="modelErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="14.0">
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Type" styleClass="field-label"/>
                    <ComboBox fx:id="typeCombo" promptText="Select type" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="typeErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Seats" styleClass="field-label"/>
                    <ComboBox fx:id="seatsCombo" promptText="Choose a type first" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="seatsErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="14.0">
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Color" styleClass="field-label"/>
                    <ComboBox fx:id="colorCombo" promptText="Select color" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="colorErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" prefWidth="0.0" spacing="4.0">
                    <Label text="Rate/day" styleClass="field-label"/>
                    <TextField fx:id="rateField" promptText="1500" prefHeight="40.0" styleClass="field-input"/>
                    <Label fx:id="rateErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
                </VBox>
            </HBox>

            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>

            <Label fx:id="formMessageLabel" styleClass="error-label" wrapText="true"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Cancel" styleClass="ghost-button" onAction="#onCancelAddVehicle"/>
                <Button text="Save vehicle" styleClass="cta-button" onAction="#onSaveVehicleClick"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Edit vehicle overlay (rate and color) -->
    <StackPane fx:id="editRateOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-card" spacing="14.0" maxWidth="460.0" maxHeight="-Infinity">
            <padding><Insets top="26.0" bottom="26.0" left="30.0" right="30.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Edit vehicle" styleClass="modal-title"/>
                    <Label fx:id="editRateVehicleLabel" text="-" styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <Button text="X" styleClass="modal-close" onAction="#onCancelEditRate"/>
            </HBox>

            <VBox spacing="4.0">
                <Label text="Rate per day (&#8369;)" styleClass="field-label"/>
                <TextField fx:id="newRateField" promptText="1500" prefHeight="40.0" styleClass="field-input" onAction="#onSaveRateClick"/>
                <Label fx:id="newRateErrorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="Color" styleClass="field-label"/>
                <ComboBox fx:id="editColorCombo" promptText="Select color" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="Seats (choices depend on the car's type)" styleClass="field-label"/>
                <ComboBox fx:id="editSeatsCombo" promptText="Select seats" maxWidth="Infinity" prefHeight="40.0" styleClass="field-input"/>
            </VBox>

            <Label text="A new rate applies to new rentals only. Rentals already made keep the price they were booked at."
                   styleClass="page-subtitle" wrapText="true" minHeight="-Infinity"/>

            <Label fx:id="editRateMessageLabel" styleClass="error-label" wrapText="true"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Cancel" styleClass="ghost-button" onAction="#onCancelEditRate"/>
                <Button text="Save changes" styleClass="cta-button" onAction="#onSaveRateClick"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
